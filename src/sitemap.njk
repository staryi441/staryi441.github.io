---
permalink: sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
    <lastmod>{{ buildDate | isoDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ site.url }}/ai-skills/</loc>
    <lastmod>{{ buildDate | isoDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {% for project in collections.projects %}
  <url>
    <loc>{{ site.url }}{{ project.url }}</loc>
    <lastmod>{{ (project.data.updateDate or project.data.releaseDate) | isoDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
  {% endfor %}
  {% for skill in collections.skills %}
  <url>
    <loc>{{ site.url }}{{ skill.url }}</loc>
    <lastmod>{{ (skill.data.updated or skill.data.date) | isoDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  {% endfor %}

  <url>
    <loc>{{ site.url }}/security-policy/</loc>
    <lastmod>{{ buildDate | isoDate }}</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>{{ site.url }}/hall-of-fame/</loc>
    <lastmod>{{ buildDate | isoDate }}</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>{{ site.url }}/projects/worktracker/privacy/</loc>
    <lastmod>{{ buildDate | isoDate }}</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.4</priority>
  </url>
</urlset>